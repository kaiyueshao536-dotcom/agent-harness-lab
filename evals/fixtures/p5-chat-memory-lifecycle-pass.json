{
  "name": "P5 Chat memory lifecycle quality gate",
  "gate": {
    "min_pass_rate": 1.0,
    "min_average_score": 1.0,
    "max_duration_regression_percent": null
  },
  "cases": [
    {
      "name": "A 显著约束在压缩后保留",
      "rules": [
        { "kind": "memory_contains_active", "values": ["部署区域=ap-guangzhou"], "threshold": null, "description": "保留明确的地域约束" },
        { "kind": "memory_no_ungrounded", "values": [], "threshold": null, "description": "所有记忆都可追溯" },
        { "kind": "memory_compaction_succeeded", "values": [], "threshold": null, "description": "压缩成功" }
      ],
      "observation": {
        "trace_id": "fixture_trace_p5_a",
        "execution_type": "chat",
        "output_text": "将继续在 ap-guangzhou 分析。",
        "tool_names": [], "reference_count": 0, "context_source_names": [],
        "context_tokens": 420, "duration_ms": 1200, "trace_status": "succeeded",
        "memory_active_values": ["部署区域=ap-guangzhou"],
        "memory_superseded_values": [], "memory_ungrounded_count": 0,
        "memory_status": "succeeded", "memory_duration_ms": 800
      }
    },
    {
      "name": "B 新值覆盖旧值",
      "rules": [
        { "kind": "memory_contains_active", "values": ["超时阈值=5s"], "threshold": null, "description": "新值生效" },
        { "kind": "memory_excludes_active", "values": ["超时阈值=30s"], "threshold": null, "description": "旧值不再注入" }
      ],
      "observation": {
        "trace_id": "fixture_trace_p5_b", "execution_type": "chat",
        "output_text": "当前以 5s 为准。", "tool_names": [], "reference_count": 0,
        "context_source_names": [], "context_tokens": 380, "duration_ms": 1000,
        "trace_status": "succeeded", "memory_active_values": ["超时阈值=5s"],
        "memory_superseded_values": ["超时阈值=30s"],
        "memory_ungrounded_count": 0, "memory_status": "succeeded", "memory_duration_ms": 650
      }
    },
    {
      "name": "C 有规律数据不自行补全",
      "rules": [
        { "kind": "memory_excludes_active", "values": ["CASE-31"], "threshold": null, "description": "不根据规律推断缺失值" },
        { "kind": "memory_no_ungrounded", "values": [], "threshold": null, "description": "拒绝无来源事实" }
      ],
      "observation": {
        "trace_id": "fixture_trace_p5_c", "execution_type": "chat",
        "output_text": "只能确认已显式提供的编号。", "tool_names": [], "reference_count": 0,
        "context_source_names": [], "context_tokens": 500, "duration_ms": 1100,
        "trace_status": "succeeded", "memory_active_values": ["最后明确编号=CASE-30"],
        "memory_superseded_values": [], "memory_ungrounded_count": 0,
        "memory_status": "succeeded", "memory_duration_ms": 720
      }
    },
    {
      "name": "D 不可推导长上下文与流式防重",
      "rules": [
        { "kind": "no_exact_duplicate", "values": [], "threshold": null, "description": "回答不重复" },
        { "kind": "max_memory_duration_ms", "values": [], "threshold": 45000, "description": "压缩有有界超时" },
        { "kind": "trace_succeeded", "values": [], "threshold": null, "description": "链路完成" }
      ],
      "observation": {
        "trace_id": "fixture_trace_p5_d", "execution_type": "chat",
        "output_text": "未出现的约束不能推断。", "tool_names": [], "reference_count": 0,
        "context_source_names": [], "context_tokens": 640, "duration_ms": 1600,
        "trace_status": "succeeded", "memory_active_values": [],
        "memory_superseded_values": [], "memory_ungrounded_count": 0,
        "memory_status": "succeeded", "memory_duration_ms": 900
      }
    }
  ]
}
